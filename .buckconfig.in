[cells]
  root = .
  prelude = prelude
  dev_buck = dev-buck
  vendor = vendor

[alias]
  release = dev_buck//mode:release
  debug = dev_buck//mode:debug

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = prelude
  fbsource = prelude
  fbcode_macros = prelude
  buck = prelude
  toolchains = dev_buck

[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = \
    target:root//...->prelude//platforms:default \
    target:dev_buck//...->prelude//platforms:default \
    target:vendor//...->prelude//platforms:default

[build]
  execution_platforms = prelude//platforms:default

[buck2]
  file_watcher = watchman
