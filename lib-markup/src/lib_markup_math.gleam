      aria_multi_selectable,
      aria_orientation,
      aria_placeholder,
      aria_pos_in_set,
      aria_pressed,
      aria_read_only,
      aria_required,
      aria_role_description,
      aria_row_count,
      aria_row_index,
      aria_row_span,
      aria_selected,
      aria_set_size,
      aria_sort,
      aria_value_max,
      aria_value_min,
      aria_value_now,
      aria_value_text,
      id,
      aria_disabled,
      class_names,
      nonce,
      role,
      slot,
      tab_index,
      autofocus,
      events,
    )
  let attrs = attr.add_style(attrs, style)
  let attrs = attr.add_events(attrs, events)
  let attrs = attr.add_on_add(attrs, on_add)
  let attrs =
    list.append(attrs, [
      fragment.ReactiveOptionalStringAttribute("alttext", alt_text),
      fragment.ReactiveOptionalStringAttribute(
        "display",
        attr.map_optional(display, display_text),
      ),
      fragment.ReactiveOptionalStringAttribute(
        "displaystyle",
        attr.map_optional(display_style, attr.bool_text),
      ),
      fragment.ReactiveOptionalStringAttribute(
        "dir",
        attr.map_optional(math_dir, math_dir_text),
      ),
      fragment.ReactiveOptionalStringAttribute(
        "scriptlevel",
        attr.map_optional(script_level, int.to_string),
      ),
    ])
  fragment.element_in(fragment.MathMl, "math", attrs, content)
}

