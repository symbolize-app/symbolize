fn value_text(value: MathValue) -> String {
  case value {
    MathLength(value) -> styling.length_text(value)
    MathPercentage(value) -> styling.percentage_text(value)
  }
}

// These entry points preserve the source's element-dependent portal records
// without exposing the internal fragment attribute representation.
pub fn portal(node: fragment.Node, attrs: MathAttrs) -> fragment.Fragment {
  to_portal(node, math(attrs))
}

pub fn portal_mi(node: fragment.Node, attrs: MiAttrs) -> fragment.Fragment {
  to_portal(node, mi(attrs))
}

pub fn portal_mo(node: fragment.Node, attrs: MoAttrs) -> fragment.Fragment {
  to_portal(node, mo(attrs))
}

fn to_portal(
  node: fragment.Node,
  value: fragment.Fragment,
) -> fragment.Fragment {
  case value {
    fragment.ElementNode(_, _, attributes, content) ->
      fragment.PortalNode(node, attributes, content)
    _ -> panic as "expected an element fragment"
  }
}

fn display_text(value: MathDisplay) -> String {
  case value {
    MathBlock -> "block"
    MathInline -> "inline"
  }
}

fn math_dir_text(value: MathDir) -> String {
  case value {
    MathLtr -> "ltr"
    MathRtl -> "rtl"
  }
}

fn math_variant_text(value: MathVariant) -> String {
  case value {
    MathNormal -> "normal"
  }
}

fn operator_form_text(value: OperatorForm) -> String {
  case value {
    FormInfix -> "infix"
    FormPostfix -> "postfix"
    FormPrefix -> "prefix"
  }
}
