GEN_HEADERS_CMD = """python3 -c '
import re, sys, os
with open(sys.argv[1]) as f: c = f.read()
renames = re.findall(r"\\(\\"([^\\"]+)\\",\\s*\\"([^\\"]+)\\"\\)", re.search(r"SYMBOLS_TO_RENAME:.*?=\\s*&\\[(.*?)\\];", c, re.DOTALL).group(1))
prefixes = re.findall(r"\\"([^\\"]+)\\"", re.search(r"SYMBOLS_TO_PREFIX:.*?=\\s*&\\[(.*?)\\];", c, re.DOTALL).group(1))
p = "ring_core_0_17_7_"
out = sys.argv[2]
os.makedirs(f"{out}/ring_core_generated", exist_ok=True)
with open(f"{out}/ring_core_generated/prefix_symbols.h", "w") as f:
    f.write("#ifndef ring_core_generated_PREFIX_SYMBOLS_H\\n#define ring_core_generated_PREFIX_SYMBOLS_H\\n\\n")
    for o, r in renames: f.write(f"#define {o} {r}\\n")
    for s in prefixes: f.write(f"#define {s} {p}{s}\\n")
    f.write("\\n#endif\\n")
with open(f"{out}/ring_core_generated/prefix_symbols_asm.h", "w") as f:
    f.write("#ifndef ring_core_generated_PREFIX_SYMBOLS_ASM_H\\n#define ring_core_generated_PREFIX_SYMBOLS_ASM_H\\n\\n#if defined(__APPLE__)\\n")
    for o, r in renames: f.write(f"#define _{o} _{r}\\n")
    for s in prefixes: f.write(f"#define _{s} _{p}{s}\\n")
    f.write("\\n#else\\n")
    for o, r in renames: f.write(f"#define {o} {r}\\n")
    for s in prefixes: f.write(f"#define {s} {p}{s}\\n")
    f.write("\\n#endif\\n\\n#endif\\n")
' build.rs $OUT"""

genrule(
    name = "ring-headers",
    out = "include",
    srcs = ["build.rs"],
    cmd = GEN_HEADERS_CMD,
)

