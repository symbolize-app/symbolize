load("@root//:workspace.bzl", "members")

def _diff_impl(ctx: bxl.Context):
    target = ctx.cli_args.target
    if target:
        utargets = ctx.uquery().eval(target)
        targets = ctx.configured_targets(utargets, modifiers = ctx.modifiers)
    else:
        diff_targets = [f"root//{pkg}:format-diff" for pkg in members]
        targets = ctx.configured_targets(diff_targets, modifiers = ctx.modifiers)
    seen = {}
    build_results = ctx.build(targets)

    for target, res in build_results.items():
        for art in res.artifacts():
            if art.basename == "format.diff":
                ensured = ctx.output.ensure(art)
                path = str(ensured.abs_path())
                if path not in seen:
                    seen[path] = True
                    ctx.output.print(ensured.abs_path())

diff = bxl_main(
    impl = _diff_impl,
    cli_args = {
        "target": cli_args.option(cli_args.string()),
    },
)

def _check_impl(ctx: bxl.Context):
    target = ctx.cli_args.target
    if target:
        utargets = ctx.uquery().eval(target)
        targets = ctx.configured_targets(utargets, modifiers = ctx.modifiers)
    else:
        check_targets = [f"root//{pkg}:format-check" for pkg in members]
        targets = ctx.configured_targets(check_targets, modifiers = ctx.modifiers)

    results = ctx.build(targets)
    failed = False
    for target, res in results.items():
        if len(res.failures()) > 0:
            failed = True

    if failed:
        fail("Formatting check failed.")

check = bxl_main(
    impl = _check_impl,
    cli_args = {
        "target": cli_args.option(cli_args.string()),
    },
)


