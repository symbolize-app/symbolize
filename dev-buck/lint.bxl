load("@root//:workspace.bzl", "gleam_members", "haskell_members", "rust_members")

_all_members = rust_members + gleam_members + haskell_members

def _check_impl(ctx: bxl.Context):
    target = ctx.cli_args.target
    if target:
        utargets = ctx.uquery().eval(target)
        targets = ctx.configured_targets(utargets, modifiers = ctx.modifiers)
    else:
        lint_targets = [f"root//{pkg}:lint" for pkg in _all_members]
        targets = ctx.configured_targets(lint_targets, modifiers = ctx.modifiers)
    results = ctx.build(targets)
    failed = False
    for target, res in results.items():
        if len(res.failures()) > 0:
            failed = True

    if failed:
        fail("Lint check failed.")

check = bxl_main(
    impl = _check_impl,
    cli_args = {
        "target": cli_args.option(cli_args.string()),
    },
)
